{
  "name": "wp-tutoring",
  "private": true,
  "description": "West Philadelphia Tutoring — frontend (Vite + React) and backend (FastAPI + MongoDB)",
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "cd backend && ./venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001 --reload",
    "build": "npm run build --prefix frontend",
    "start": "npm run preview --prefix frontend",
    "lint": "npm run lint --prefix frontend"
  },
  "dependencies": {
    "mongodb": "^6.21.0"
  }
}
